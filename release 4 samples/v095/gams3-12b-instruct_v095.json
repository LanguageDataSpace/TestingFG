  "dcatlds:finetuningMethodology": [
    { "@language": "en", "@value": "Supervised Fine-Tuning (SFT) on a combination of Slovene and English instruction-following, conversational, and safety datasets." }
  ],
  "it6:intendedUse": [
    {
      "@language": "en",
      "@value": "Designed for instruction-following and multi-turn conversational chat, with a particular focus on Slovene and other South Slavic languages. Effective for question answering, text generation, summarization, and general-purpose language tasks in Slovene and English."
    }
  ],
  "it6:limitations": [
    {
      "@language": "en",
      "@value": "Performance may be reduced in low-resource South Slavic languages (Croatian, Serbian, Bosnian) compared to Slovene and English, which received the most training data. As a 12B parameter model fine-tuned primarily on public and synthetic datasets, it may produce hallucinations or biased outputs. Use is subject to the Gemma License terms set by Google."
    }
  ],
