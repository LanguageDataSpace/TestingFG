  "it6:trainingMethodologies": [
    {
      "@language": "en",
      "@value": "Continual Pretraining: The Gemma 3 base model was continually pretrained on large multilingual corpora covering Slovene, English, Croatian, Serbian, and Bosnian, including web, encyclopedic, legal, academic, OCR-ed historical texts, and synthetic data. Supervised Fine-Tuning (SFT): The continually pretrained model was instruction-tuned on a curated mix of Slovene and English datasets covering question answering, writing, code, chat, and safety prompts."
    }
  ],
  "it6:trainingProcess": [
    {
      "@language": "en",
      "@value": "The model was initialized from Google's Gemma 3 12B pretrained weights and subjected to continual pretraining on Slovene-centric and multilingual corpora from sources including Wikipedia, FineWeb-2, FinePDFS, CLARIN.SI resources (KAS, MaCoCu, Trendi, MetaFida), Nemotron pretraining datasets, and digitised collections from the National and University Library of Slovenia. Following continual pretraining, supervised fine-tuning was performed using proprietary and project-internal datasets developed within the GaMS and PoVeJMo projects, as well as high-quality English synthetic datasets from NVIDIA Nemotron."
    }
  ],
  "it6:bias": [
    { "@language": "en", "@value": "Primarily trained and instruction-tuned on Slovene and English data; performance may be lower for Croatian, Serbian, and Bosnian, which were included in smaller proportions. May reflect biases present in web-scale and publicly available training corpora, including cultural, social, and demographic biases." }
  ],
  "it6:designSpecifications": [
    { "@language": "en", "@value": "12-billion-parameter transformer-based decoder-only large language model based on the Gemma 3 architecture, optimized for instruction following in Slovene and English. Multilingual by design, covering Slovene, English, Croatian, Serbian, and Bosnian, with a distribution size of 23.6 GB." }
  ],
