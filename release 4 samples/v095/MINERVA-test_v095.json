  "it6:designSpecifications": [
    {
      "@language": "en",
      "@value": "Minerva-7B-base-v1.0 is a transformer model based on the Mistral architecture. Tokens: 2.48T (1.14T it + 1.14T en + 200B code); Layers: 32; Hidden Size: 4096; Attention Heads: 32; Sliding Window: none. Token fertility: 1.32 (on CulturaX), 1.56 (on Wikipedia)"
    }
  ],
