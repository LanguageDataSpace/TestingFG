  "dcatlds:finetuningMethodology": [
    {
      "@language": "en",
      "@value": "Supervised Fine-Tuning (SFT) on public instruction datasets and conversational data."
    }
  ],
  "dcatlds:instructions": [
    {
      "@language": "en",
      "@value": "To use this instruct-tuned model, prompts must be wrapped in [INST] and [/INST] tokens. The first instruction should be preceded by a start-of-sentence token <s>. The model supports a context window of up to 32,768 tokens. For multi-turn conversations, the format should follow: <s>[INST] Instruction 1 [/INST] Model Answer 1</s>[INST] Instruction 2 [/INST]."
    }
  ],
  "it6:intendedUse": [
    {
      "@language": "en",
      "@value": "Designed for instruction-following, multi-turn conversational chat, and complex reasoning tasks. It is highly effective for text summarization, content generation, retrieval-augmented generation (RAG) applications, and code-related assistance including generation and debugging."
    }
  ],
  "it6:limitations": [
    {
      "@language": "en",
      "@value": "The model has a knowledge cutoff of November 2023 and may provide inaccurate information regarding events after this date. As a 7B parameter model, it has a more limited knowledge base compared to larger models (e.g., Mistral Large) and is prone to hallucinations. It lacks a built-in safety moderation layer, meaning it may generate harmful or biased content if prompted. Furthermore, performance is primarily optimized for English, with reduced accuracy in other languages."
    }
  ],
