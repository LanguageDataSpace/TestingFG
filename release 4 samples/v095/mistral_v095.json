  "it6:trainingMethodologies": [
    {
      "@language": "en",
      "@value": "Pretrained using self-supervised next-token prediction on large-scale publicly available text datasets. Instruction-tuned using supervised fine-tuning on curated instruction-response datasets to improve alignment and task adherence."
    }
  ],
  "it6:trainingProcess": [
    {
      "@language": "en",
      "@value": "Base model pretrained on diverse web and textual corpora using autoregressive language modeling objectives. Subsequently fine-tuned to create the Instruct v0.2 variant, improving response helpfulness, coherence, and compliance with user instructions. Developed and released by Mistral AI as an instruction-tuned variant of the Mistral 7B base model. Version v0.2 represents an updated instruction-tuned release with improved alignment and response quality compared to earlier instruct versions."
    }
  ],
  "it6:bias": [
    {
      "@language": "en",
      "@value": "Primarily trained and instruction-tuned on English data, which may result in stronger performance in English and potential underperformance in low-resource languages. May reflect biases present in publicly available web-scale training corpora, including cultural, social, and demographic biases."
    }
  ],
  "it6:designSpecifications": [
    {
      "@language": "en",
      "@value": "7-billion-parameter transformer-based decoder-only large language model optimized for instruction following. Uses grouped-query attention (GQA) and sliding window attention mechanisms for improved efficiency and long-context handling."
    }
  ],
  "ms:requiresSoftware": [
    {
      "@language": "en",
      "@value": "Requires a compatible inference framework such as Hugging Face Transformers for loading and serving the model."
    }
  ],
