  "dct:description": [
    {
      "@language": "en",
      "@value": "Mistral-7B-Instruct-v0.2 is an instruct fine-tuned version of the Mistral-7B-v0.2 base model. It is a 7.3 billion parameter transformer model that outperforms many larger models like Llama 2 13B. This version supports a 32,768 token context window and features Grouped-query attention (GQA) for faster inference."
    }
  ],
